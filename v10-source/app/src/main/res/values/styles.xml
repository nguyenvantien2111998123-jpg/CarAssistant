<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Car screen / AA theme (fullscreen, dark blue tint) -->
    <style name="Theme.AACast" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#ff080e18</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ff00e5ff</item>
        <item name="android:statusBarColor">#ff080e18</item>
        <item name="android:navigationBarColor">#ff080e18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Phone settings screen theme -->
    <style name="Theme.AACast.Phone" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#ff080e18</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ff00e5ff</item>
        <item name="android:statusBarColor">#ff080e18</item>
        <item name="android:navigationBarColor">#ff080e18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
