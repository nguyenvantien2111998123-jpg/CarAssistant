              )

          if "import android.widget.EditText;" not in text:
              text = text.replace(
                  "import android.widget.TextView;",
                  "import android.widget.TextView;\n"
                  "import android.widget.EditText;",
                  1
              )

          if "private final NavigationSearchController navigationSearch" \
                  not in text:

              marker = "private NavigationMapView navigationMap;"

              replacement = marker + """
          private final NavigationSearchController navigationSearch =
                  new NavigationSearchController();

          private final NavigationRouteController navigationRoute =
                  new NavigationRouteController();"""

              text = text.replace(
                  marker,
                  replacement,
                  1
              )

          marker = "    private void buildDashboard() {"

          if marker not in text:
              raise SystemExit(
                  "buildDashboard marker missing"
              )

          methods = r'''
          private void openNavigationSearch() {

              final EditText input =
                      new EditText(this);

              input.setSingleLine(true);
              input.setHint("Tìm địa điểm");

              new AlertDialog.Builder(this)
                      .setTitle("Navigation")
                      .setView(input)
                      .setNegativeButton(
                              "Hủy",
                              null)
                      .setPositiveButton(
                              "Tìm",
                              (dialog, which) -> {

                                  String query =
                                          input.getText()
                                                  .toString()
                                                  .trim();

                                  navigationSearch.search(
                                          query,
                                          new NavigationSearchController.Callback() {

                                              @Override
                                              public void onResults(
                                                      java.util.List<NavigationSearchController.SearchResult> results) {

                                                  if (results == null
                                                          || results.isEmpty()) {

                                                      new AlertDialog.Builder(
                                                              V10CarActivity.this)
                                                              .setMessage(
                                                                      "Không tìm thấy địa điểm.")
                                                              .setPositiveButton(
                                                                      "OK",
                                                                      null)
                                                              .show();

                                                      return;
                                                  }

                                                  CharSequence[] names =
                                                          new CharSequence[
                                                                  results.size()];

                                                  for (int i = 0;
                                                       i < results.size();
                                                       i++) {

                                                      names[i] =
                                                              results.get(i)
                                                                      .name;
                                                  }

                                                  new AlertDialog.Builder(
                                                          V10CarActivity.this)
                                                          .setTitle(
                                                                  "Chọn điểm đến")
                                                          .setItems(
                                                                  names,
                                                                  (d, selected) -> {

                                                                      NavigationSearchController
                                                                              .SearchResult destination =
                                                                              results.get(selected);

                                                                      calculateNavigationRoute(
                                                                              destination.position);
                                                                  })
                                                          .show();
                                              }

                                              @Override
                                              public void onError(
                                                      String message) {

                                                  new AlertDialog.Builder(
                                                          V10CarActivity.this)
                                                          .setMessage(message)
                                                          .setPositiveButton(
                                                                  "OK",
                                                                  null)
                                                          .show();
                                              }
                                          });
                              })
                      .show();
          }

          private void calculateNavigationRoute(
                  org.maplibre.android.geometry.LatLng destination) {

              if (navigationMap == null) {
                  return;
              }

              NavigationCameraController camera =
                      navigationMap.getCameraController();

              if (camera == null) {
                  return;
              }

              android.location.Location current =
                      camera.getCurrentLocation();

              if (current == null) {

                  new AlertDialog.Builder(this)
                          .setMessage(
                                  "Chưa lấy được vị trí hiện tại.")
                          .setPositiveButton(
                                  "OK",
                                  null)
                          .show();

                  return;
              }

              org.maplibre.android.geometry.LatLng origin =
                      new org.maplibre.android.geometry.LatLng(
                              current.getLatitude(),
                              current.getLongitude());

              navigationRoute.route(
                      origin,
                      destination,
                      new NavigationRouteController.Callback() {

                          @Override
                          public void onRoute(
                                  NavigationRouteController.RouteResult route) {

                              if (navigationMap != null) {
                                  navigationMap.renderRoute(route);
                              }

                              String distance;

                              if (route.distanceMeters >= 1000.0) {
                                  distance =
                                          String.format(
                                                  java.util.Locale.US,
                                                  "%.1f km",
                                                  route.distanceMeters / 1000.0);
                              } else {
                                  distance =
                                          String.format(
                                                  java.util.Locale.US,
                                                  "%.0f m",
                                                  route.distanceMeters);
                              }

                              long minutes =
                                      Math.max(
                                              1L,
                                              Math.round(
                                                      route.durationSeconds / 60.0));

                              new AlertDialog.Builder(
                                      V10CarActivity.this)
                                      .setTitle("Đã có tuyến đường")
                                      .setMessage(
                                              "Khoảng cách: "
                                                      + distance
                                                      + "\nThời gian dự kiến: "
                                                      + minutes
                                                      + " phút")
                                      .setPositiveButton(
                                              "OK",
                                              null)
                                      .show();
                          }

                          @Override
                          public void onError(
                                  String message) {

                              new AlertDialog.Builder(
                                      V10CarActivity.this)
                                      .setMessage(message)
                                      .setPositiveButton(
                                              "OK",
                                              null)
                                      .show();
                          }
                      });
          }

          '''

          text = text.replace(
              marker,
              methods + marker,
              1
