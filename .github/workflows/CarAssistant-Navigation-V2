name: Build Navigation V2 from Navigation V1 Baseline

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  navigation-v2:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Navigation V1 baseline
        uses: actions/checkout@v4
        with:
          ref: 2c814a181d00cde9547a446927ae181e18cb9cbb
          fetch-depth: 1

      - name: Verify exact Navigation V1 baseline
        shell: bash
        run: |
          set -euo pipefail

          EXPECTED="2c814a181d00cde9547a446927ae181e18cb9cbb"
          ACTUAL="$(git rev-parse HEAD)"

          echo "EXPECTED=$EXPECTED"
          echo "ACTUAL=$ACTUAL"

          test "$ACTUAL" = "$EXPECTED"

          echo "NAVIGATION V1 BASELINE: PASS"

      - name: Setup Java 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "17"

      - name: Verify exact project tree
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"

          test -d "v10-source"
          test -d "v10-source/app"
          test -d "v10-source/app/src"
          test -d "v10-source/app/src/main"
          test -d "v10-source/app/src/main/java"
          test -d "v10-source/app/src/main/java/com"
          test -d "v10-source/app/src/main/java/com/hieptran"
          test -d "v10-source/app/src/main/java/com/hieptran/aacast"
          test -d "$SRC"

          test -f "v10-source/gradlew"
          test -f "v10-source/app/build.gradle"
          test -f "v10-source/app/src/main/AndroidManifest.xml"

          test -f "$SRC/V10CarActivity.java"
          test -f "$SRC/NavigationMapView.java"

          echo "PROJECT TREE: PASS"
          echo "NAVIGATION SOURCE PATH: $SRC"

      - name: Verify actual packages and existing Navigation V1
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"

          grep -Fq 'package com.carassistant.v10;' \
            "$SRC/V10CarActivity.java"

          grep -Fq 'package com.carassistant.v10;' \
            "$SRC/NavigationMapView.java"

          grep -Fq 'class V10CarActivity' \
            "$SRC/V10CarActivity.java"

          grep -Fq 'class NavigationMapView' \
            "$SRC/NavigationMapView.java"

          echo "PACKAGE V10CarActivity: com.carassistant.v10"
          echo "PACKAGE NavigationMapView: com.carassistant.v10"
          echo "ACTUAL PACKAGE CHECK: PASS"

      - name: Capture protected Projection Core hashes
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"

          sha256sum \
            "$SRC/V10ProjectionSession.java" \
            "$SRC/V10DisplayController.java" \
            "$SRC/V10SurfaceManager.java" \
            "$SRC/V10TaskSession.java" \
            "$SRC/V10SessionStore.java" \
            > /tmp/core-before.sha256

          echo "PROJECTION CORE HASH: PASS"

      - name: Verify existing Gradle and MapLibre baseline
        shell: bash
        run: |
          set -euo pipefail

          FILE="v10-source/app/build.gradle"

          grep -Fq \
            'namespace "com.carassistant.v10"' \
            "$FILE" || \
          grep -Fq \
            "namespace 'com.carassistant.v10'" \
            "$FILE"

          grep -Fq \
            'applicationId "com.carassistant.v10"' \
            "$FILE"

          grep -Fq \
            'org.maplibre.gl:android-sdk:11.11.0' \
            "$FILE"

          grep -Fq \
            'JavaVersion.VERSION_17' \
            "$FILE"

          echo "GRADLE BASELINE: PASS"
          echo "MAPLIBRE 11.11.0: PRESENT"

      - name: Verify existing Android resources
        shell: bash
        run: |
          set -euo pipefail

          RES="v10-source/app/src/main/res"

          test -d "$RES"
          test -d "$RES/drawable"
          test -d "$RES/values"
          test -d "$RES/values-vi"
          test -d "$RES/xml"

          test -f "$RES/values/strings.xml"
          test -f "$RES/values/styles.xml"
          test -f "$RES/values/arrays.xml"
          test -f "$RES/values-vi/strings.xml"
          test -f "$RES/xml/automotive_app_desc.xml"
          test -f "$RES/xml/data_extraction_rules.xml"

          echo "RESOURCE TREE: PASS"

      - name: Add INTERNET permission only
        shell: bash
        run: |
          set -euo pipefail

          FILE="v10-source/app/src/main/AndroidManifest.xml"

          if ! grep -Fq \
            'android.permission.INTERNET' \
            "$FILE"; then

            sed -i \
              '/<manifest /a\    <uses-permission android:name="android.permission.INTERNET" />' \
              "$FILE"
          fi

          grep -Fq \
            'android.permission.INTERNET' \
            "$FILE"

          grep -Fq \
            'android.permission.ACCESS_FINE_LOCATION' \
            "$FILE"

          grep -Fq \
            'android.permission.ACCESS_COARSE_LOCATION' \
            "$FILE"

          echo "INTERNET: PASS"
          echo "LOCATION PERMISSIONS: PRESERVED"

      - name: Create NavigationCameraController
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"
          FILE="$SRC/NavigationCameraController.java"

          cat > "$FILE" <<'EOF'
          package com.carassistant.v10;

          import android.Manifest;
          import android.content.Context;
          import android.content.pm.PackageManager;
          import android.location.Location;
          import android.location.LocationListener;
          import android.location.LocationManager;
          import android.os.Bundle;

          import org.maplibre.android.camera.CameraUpdateFactory;
          import org.maplibre.android.geometry.LatLng;
          import org.maplibre.android.maps.MapLibreMap;

          public final class NavigationCameraController {

              public interface Callback {
                  void onLocationChanged(Location location);
              }

              private final Context context;
              private final MapLibreMap map;
              private final LocationManager locationManager;
              private final Callback callback;

              private boolean following;
              private boolean started;

              private final LocationListener listener =
                      new LocationListener() {
                          @Override
                          public void onLocationChanged(Location location) {
                              if (location == null) return;

                              if (following) {
                                  map.animateCamera(
                                          CameraUpdateFactory.newLatLng(
                                                  new LatLng(
                                                          location.getLatitude(),
                                                          location.getLongitude())),
                                          250);
                              }

                              if (callback != null) {
                                  callback.onLocationChanged(location);
                              }
                          }

                          @Override
                          public void onProviderEnabled(String provider) {
                          }

                          @Override
                          public void onProviderDisabled(String provider) {
                          }

                          @Override
                          public void onStatusChanged(
                                  String provider,
                                  int status,
                                  Bundle extras) {
                          }
                      };

              public NavigationCameraController(
                      Context context,
                      MapLibreMap map,
                      Callback callback) {

                  this.context = context.getApplicationContext();
                  this.map = map;
                  this.callback = callback;
                  this.locationManager =
                          (LocationManager)
                                  context.getSystemService(
                                          Context.LOCATION_SERVICE);
              }

              public void start() {
                  if (started) return;

                  if (context.checkSelfPermission(
                              Manifest.permission.ACCESS_FINE_LOCATION)
                          != PackageManager.PERMISSION_GRANTED
                          && context.checkSelfPermission(
                              Manifest.permission.ACCESS_COARSE_LOCATION)
                          != PackageManager.PERMISSION_GRANTED) {
                      return;
                  }

                  try {
                      locationManager.requestLocationUpdates(
                              LocationManager.GPS_PROVIDER,
                              1000L,
                              2.0f,
                              listener);

                      try {
                          locationManager.requestLocationUpdates(
                                  LocationManager.NETWORK_PROVIDER,
                                  2000L,
                                  5.0f,
                                  listener);
                      } catch (Exception ignored) {
                      }

                      started = true;
                  } catch (Exception ignored) {
                  }
              }

              public void stop() {
                  if (!started) return;

                  try {
                      locationManager.removeUpdates(listener);
                  } catch (Exception ignored) {
                  }

                  started = false;
              }

              public void setFollowing(boolean value) {
                  following = value;
              }

              public boolean isFollowing() {
                  return following;
              }

              public Location getCurrentLocation() {
                  if (context.checkSelfPermission(
                              Manifest.permission.ACCESS_FINE_LOCATION)
                          != PackageManager.PERMISSION_GRANTED
                          && context.checkSelfPermission(
                              Manifest.permission.ACCESS_COARSE_LOCATION)
                          != PackageManager.PERMISSION_GRANTED) {
                      return null;
                  }

                  Location best = null;

                  try {
                      Location gps =
                              locationManager.getLastKnownLocation(
                                      LocationManager.GPS_PROVIDER);
                      best = gps;
                  } catch (Exception ignored) {
                  }

                  try {
                      Location network =
                              locationManager.getLastKnownLocation(
                                      LocationManager.NETWORK_PROVIDER);

                      if (network != null
                              && (best == null
                              || network.getTime() > best.getTime())) {
                          best = network;
                      }
                  } catch (Exception ignored) {
                  }

                  return best;
              }

              public void recenter() {
                  Location location = getCurrentLocation();

                  if (location == null) return;

                  following = true;

                  map.animateCamera(
                          CameraUpdateFactory.newLatLngZoom(
                                  new LatLng(
                                          location.getLatitude(),
                                          location.getLongitude()),
                                  16.0),
                          500);
              }

              public void onUserInteraction() {
                  following = false;
              }
          }
          EOF

          test -f "$FILE"
          grep -Fq 'package com.carassistant.v10;' "$FILE"
          grep -Fq 'class NavigationCameraController' "$FILE"
          grep -Fq 'requestLocationUpdates' "$FILE"
          grep -Fq 'recenter()' "$FILE"

          echo "CAMERA CONTROLLER: PASS"
      - name: Create NavigationSearchController
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"
          FILE="$SRC/NavigationSearchController.java"

          cat > "$FILE" <<'EOF'
          package com.carassistant.v10;

          import android.os.Handler;
          import android.os.Looper;

          import org.json.JSONArray;
          import org.json.JSONObject;
          import org.maplibre.android.geometry.LatLng;

          import java.io.BufferedReader;
          import java.io.InputStream;
          import java.io.InputStreamReader;
          import java.net.HttpURLConnection;
          import java.net.URLEncoder;
          import java.net.URL;
          import java.nio.charset.StandardCharsets;
          import java.util.ArrayList;
          import java.util.List;

          public final class NavigationSearchController {

              public static final class SearchResult {
                  public final String name;
                  public final LatLng position;

                  SearchResult(
                          String name,
                          LatLng position) {
                      this.name = name;
                      this.position = position;
                  }

                  @Override
                  public String toString() {
                      return name;
                  }
              }

              public interface Callback {
                  void onResults(List<SearchResult> results);
                  void onError(String message);
              }

              private final Handler mainHandler =
                      new Handler(Looper.getMainLooper());

              public void search(
                      final String query,
                      final Callback callback) {

                  new Thread(
                          () -> performSearch(query, callback),
                          "NavigationSearch")
                          .start();
              }

              private void performSearch(
                      String query,
                      Callback callback) {

                  if (query == null
                          || query.trim().isEmpty()) {
                      mainHandler.post(
                              () -> callback.onError(
                                      "Nhập địa điểm cần tìm."));
                      return;
                  }

                  HttpURLConnection connection = null;

                  try {
                      String encoded =
                              URLEncoder.encode(
                                      query.trim(),
                                      StandardCharsets.UTF_8.name());

                      String endpoint =
                              "https://nominatim.openstreetmap.org/search"
                              + "?format=json"
                              + "&limit=6"
                              + "&q="
                              + encoded;

                      URL url = new URL(endpoint);

                      connection =
                              (HttpURLConnection)
                                      url.openConnection();

                      connection.setRequestMethod("GET");
                      connection.setConnectTimeout(10000);
                      connection.setReadTimeout(10000);
                      connection.setRequestProperty(
                              "User-Agent",
                              "CarAssistant-V2/1.0");

                      int code =
                              connection.getResponseCode();

                      if (code != HttpURLConnection.HTTP_OK) {
                          throw new IllegalStateException(
                                  "Search HTTP " + code);
                      }

                      String body =
                              read(connection.getInputStream());

                      JSONArray array =
                              new JSONArray(body);

                      ArrayList<SearchResult> results =
                              new ArrayList<>();

                      for (int i = 0;
                           i < array.length();
                           i++) {

                          JSONObject item =
                                  array.getJSONObject(i);

                          double lat =
                                  Double.parseDouble(
                                          item.getString("lat"));

                          double lon =
                                  Double.parseDouble(
                                          item.getString("lon"));

                          String name =
                                  item.optString(
                                          "display_name",
                                          query.trim());

                          results.add(
                                  new SearchResult(
                                          name,
                                          new LatLng(lat, lon)));
                      }

                      mainHandler.post(
                              () -> callback.onResults(results));

                  } catch (Exception e) {

                      String message =
                              e.getMessage() == null
                                      ? "Không tìm được địa điểm."
                                      : e.getMessage();

                      mainHandler.post(
                              () -> callback.onError(message));

                  } finally {
                      if (connection != null) {
                          connection.disconnect();
                      }
                  }
              }

              private static String read(
                      InputStream input)
                      throws Exception {

                  StringBuilder out =
                          new StringBuilder();

                  BufferedReader reader =
                          new BufferedReader(
                                  new InputStreamReader(
                                          input,
                                          StandardCharsets.UTF_8));

                  String line;

                  while ((line = reader.readLine()) != null) {
                      out.append(line);
                  }

                  reader.close();

                  return out.toString();
              }
          }
          EOF

          test -f "$FILE"
          grep -Fq 'package com.carassistant.v10;' "$FILE"
          grep -Fq 'class NavigationSearchController' "$FILE"
          grep -Fq 'nominatim.openstreetmap.org' "$FILE"
          grep -Fq 'SearchResult' "$FILE"

          echo "SEARCH CONTROLLER: PASS"

      - name: Create NavigationRouteController
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"
          FILE="$SRC/NavigationRouteController.java"

          cat > "$FILE" <<'EOF'
          package com.carassistant.v10;

          import android.os.Handler;
          import android.os.Looper;

          import org.json.JSONArray;
          import org.json.JSONObject;
          import org.maplibre.android.geometry.LatLng;

          import java.io.BufferedReader;
          import java.io.InputStream;
          import java.io.InputStreamReader;
          import java.net.HttpURLConnection;
          import java.net.URL;
          import java.nio.charset.StandardCharsets;
          import java.util.ArrayList;
          import java.util.List;
          import java.util.Locale;

          public final class NavigationRouteController {

              public static final class RouteResult {
                  public final List<LatLng> points;
                  public final double distanceMeters;
                  public final double durationSeconds;

                  RouteResult(
                          List<LatLng> points,
                          double distanceMeters,
                          double durationSeconds) {

                      this.points = points;
                      this.distanceMeters = distanceMeters;
                      this.durationSeconds = durationSeconds;
                  }
              }

              public interface Callback {
                  void onRoute(RouteResult route);
                  void onError(String message);
              }

              private final Handler mainHandler =
                      new Handler(Looper.getMainLooper());

              public void route(
                      final LatLng from,
                      final LatLng to,
                      final Callback callback) {

                  if (from == null || to == null) {
                      callback.onError(
                              "Chưa có vị trí hiện tại.");
                      return;
                  }

                  new Thread(
                          () -> performRoute(
                                  from,
                                  to,
                                  callback),
                          "NavigationRoute")
                          .start();
              }

              private void performRoute(
                      LatLng from,
                      LatLng to,
                      Callback callback) {

                  HttpURLConnection connection = null;

                  try {
                      String endpoint =
                              String.format(
                                      Locale.US,
                                      "https://router.project-osrm.org/route/v1/driving/"
                                      + "%f,%f;%f,%f"
                                      + "?overview=full&geometries=geojson",
                                      from.getLongitude(),
                                      from.getLatitude(),
                                      to.getLongitude(),
                                      to.getLatitude());

                      URL url = new URL(endpoint);

                      connection =
                              (HttpURLConnection)
                                      url.openConnection();

                      connection.setRequestMethod("GET");
                      connection.setConnectTimeout(12000);
                      connection.setReadTimeout(12000);
                      connection.setRequestProperty(
                              "User-Agent",
                              "CarAssistant-V2/1.0");

                      int code =
                              connection.getResponseCode();

                      if (code != HttpURLConnection.HTTP_OK) {
                          throw new IllegalStateException(
                                  "Route HTTP " + code);
                      }

                      String body =
                              read(connection.getInputStream());

                      JSONObject root =
                              new JSONObject(body);

                      JSONArray routes =
                              root.getJSONArray("routes");

                      if (routes.length() == 0) {
                          throw new IllegalStateException(
                                  "Không tìm thấy tuyến đường.");
                      }

                      JSONObject route =
                              routes.getJSONObject(0);

                      double distance =
                              route.optDouble(
                                      "distance",
                                      0.0);

                      double duration =
                              route.optDouble(
                                      "duration",
                                      0.0);

                      JSONObject geometry =
                              route.getJSONObject("geometry");

                      JSONArray coordinates =
                              geometry.getJSONArray("coordinates");

                      ArrayList<LatLng> points =
                              new ArrayList<>();

                      for (int i = 0;
                           i < coordinates.length();
                           i++) {

                          JSONArray coordinate =
                                  coordinates.getJSONArray(i);

                          double lon =
                                  coordinate.getDouble(0);

                          double lat =
                                  coordinate.getDouble(1);

                          points.add(
                                  new LatLng(lat, lon));
                      }

                      RouteResult result =
                              new RouteResult(
                                      points,
                                      distance,
                                      duration);

                      mainHandler.post(
                              () -> callback.onRoute(result));

                  } catch (Exception e) {

                      String message =
                              e.getMessage() == null
                                      ? "Không tính được tuyến đường."
                                      : e.getMessage();

                      mainHandler.post(
                              () -> callback.onError(message));

                  } finally {
                      if (connection != null) {
                          connection.disconnect();
                      }
                  }
              }

              private static String read(
                      InputStream input)
                      throws Exception {

                  StringBuilder out =
                          new StringBuilder();

                  BufferedReader reader =
                          new BufferedReader(
                                  new InputStreamReader(
                                          input,
                                          StandardCharsets.UTF_8));

                  String line;

                  while ((line = reader.readLine()) != null) {
                      out.append(line);
                  }

                  reader.close();

                  return out.toString();
              }
          }
          EOF

          test -f "$FILE"
          grep -Fq 'package com.carassistant.v10;' "$FILE"
          grep -Fq 'class NavigationRouteController' "$FILE"
          grep -Fq 'router.project-osrm.org' "$FILE"
          grep -Fq 'RouteResult' "$FILE"

          echo "ROUTE CONTROLLER: PASS"

      - name: Create NavigationRouteRenderer
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"
          FILE="$SRC/NavigationRouteRenderer.java"

          cat > "$FILE" <<'EOF'
          package com.carassistant.v10;

          import org.json.JSONArray;
          import org.json.JSONObject;
          import org.maplibre.android.geometry.LatLng;
          import org.maplibre.android.maps.MapLibreMap;
          import org.maplibre.android.style.layers.LineLayer;
          import org.maplibre.android.style.layers.PropertyFactory;
          import org.maplibre.android.style.sources.GeoJsonSource;

          import java.util.List;

          public final class NavigationRouteRenderer {

              private static final String SOURCE_ID =
                      "carassistant-navigation-route-source";

              private static final String LAYER_ID =
                      "carassistant-navigation-route-layer";

              private final MapLibreMap map;

              public NavigationRouteRenderer(
                      MapLibreMap map) {
                  this.map = map;
              }

              public void clear() {
                  try {
                      if (map.getStyle() == null) return;

                      if (map.getStyle().getLayer(LAYER_ID) != null) {
                          map.getStyle().removeLayer(LAYER_ID);
                      }

                      if (map.getStyle().getSource(SOURCE_ID) != null) {
                          map.getStyle().removeSource(SOURCE_ID);
                      }
                  } catch (Exception ignored) {
                  }
              }

              public void render(
                      List<LatLng> points) {

                  if (points == null
                          || points.size() < 2) {
                      clear();
                      return;
                  }

                  try {
                      if (map.getStyle() == null) return;

                      clear();

                      JSONArray coordinates =
                              new JSONArray();

                      for (LatLng point : points) {
                          JSONArray coordinate =
                                  new JSONArray();

                          coordinate.put(
                                  point.getLongitude());

                          coordinate.put(
                                  point.getLatitude());

                          coordinates.put(coordinate);
                      }

                      JSONObject geometry =
                              new JSONObject();

                      geometry.put(
                              "type",
                              "LineString");

                      geometry.put(
                              "coordinates",
                              coordinates);

                      JSONObject feature =
                              new JSONObject();

                      feature.put(
                              "type",
                              "Feature");

                      feature.put(
                              "geometry",
                              geometry);

                      JSONObject collection =
                              new JSONObject();

                      collection.put(
                              "type",
                              "FeatureCollection");

                      JSONArray features =
                              new JSONArray();

                      features.put(feature);

                      collection.put(
                              "features",
                              features);

                      GeoJsonSource source =
                              new GeoJsonSource(
                                      SOURCE_ID,
                                      collection.toString());

                      map.getStyle().addSource(source);

                      LineLayer line =
                              new LineLayer(
                                      LAYER_ID,
                                      SOURCE_ID);

                      line.setProperties(
                              PropertyFactory.lineColor(
                                      "#00E5FF"),
                              PropertyFactory.lineWidth(
                                      6.0f),
                              PropertyFactory.lineOpacity(
                                      0.9f),
                              PropertyFactory.lineCap(
                                      "round"),
                              PropertyFactory.lineJoin(
                                      "round"));

                      map.getStyle().addLayer(line);

                  } catch (Exception ignored) {
                  }
              }
          }
          EOF

          test -f "$FILE"
          grep -Fq 'package com.carassistant.v10;' "$FILE"
          grep -Fq 'class NavigationRouteRenderer' "$FILE"
          grep -Fq 'GeoJsonSource' "$FILE"
          grep -Fq 'LineLayer' "$FILE"

          echo "ROUTE RENDERER: PASS"

      - name: Verify Navigation V2 files and paths
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"

          for FILE in \
            NavigationMapView.java \
            NavigationCameraController.java \
            NavigationSearchController.java \
            NavigationRouteController.java \
            NavigationRouteRenderer.java
          do
            test -f "$SRC/$FILE"
            grep -Fq \
              'package com.carassistant.v10;' \
              "$SRC/$FILE"
          done

          echo "NAVIGATION V2 FILE PATHS: PASS"
          find "$SRC" -maxdepth 1 -type f -name 'Navigation*.java' -print | sort
      - name: Replace NavigationMapView with V2 implementation
        shell: bash
        run: |
          set -euo pipefail

          SRC="v10-source/app/src/main/java/com/hieptran/aacast/doudou"
          FILE="$SRC/NavigationMapView.java"

          cat > "$FILE" <<'EOF'
          package com.carassistant.v10;

          import android.Manifest;
          import android.app.Activity;
          import android.content.Context;
          import android.content.pm.PackageManager;
          import android.graphics.Color;
          import android.os.Bundle;

          import org.maplibre.android.MapLibre;
          import org.maplibre.android.camera.CameraUpdateFactory;
          import org.maplibre.android.maps.MapLibreMap;
          import org.maplibre.android.maps.MapView;
          import org.maplibre.android.maps.UiSettings;

          public final class NavigationMapView
                  extends android.widget.FrameLayout {

              private static final int LOCATION_REQUEST = 4101;

              private final MapView mapView;

              private MapLibreMap map;
              private NavigationCameraController cameraController;
              private NavigationRouteRenderer routeRenderer;

              public NavigationMapView(Context context) {
                  super(context);

                  setBackgroundColor(Color.BLACK);

                  MapLibre.getInstance(
                          context.getApplicationContext());

                  mapView = new MapView(context);

                  mapView.onCreate(
                          new Bundle());

                  addView(
                          mapView,
                          new LayoutParams(
                                  -1,
                                  -1));

                  mapView.getMapAsync(
                          this::onMapReady);
              }

              private void onMapReady(
                      MapLibreMap readyMap) {

                  map = readyMap;

                  UiSettings ui =
                          map.getUiSettings();

                  ui.setCompassEnabled(false);
                  ui.setZoomGesturesEnabled(true);
                  ui.setScrollGesturesEnabled(true);
                  ui.setRotateGesturesEnabled(true);
                  ui.setTiltGesturesEnabled(false);

                  map.setStyle(
                          "https://tiles.openfreemap.org/styles/liberty",
                          style -> {

                              enableLocation();

                              routeRenderer =
                                      new NavigationRouteRenderer(
                                              map);

                              cameraController =
                                      new NavigationCameraController(
                                              getContext(),
                                              map,
                                              null);

                              cameraController.setFollowing(
                                      true);

                              cameraController.start();

                              recenter();
                          });

                  map.addOnCameraMoveStartedListener(
                          reason -> {

                              if (cameraController == null) {
                                  return;
                              }

                              if (reason
                                      == MapLibreMap
                                      .OnCameraMoveStartedListener
                                      .REASON_API_GESTURE) {

                                  cameraController
                                          .onUserInteraction();
                              }
                          });
              }

              private void enableLocation() {

                  if (map == null) return;

                  Context context =
                          getContext();

                  if (context == null) return;

                  if (context.checkSelfPermission(
                              Manifest.permission.ACCESS_FINE_LOCATION)
                          != PackageManager.PERMISSION_GRANTED) {

                      if (context instanceof Activity) {

                          ((Activity) context)
                                  .requestPermissions(
                                          new String[]{
                                              Manifest.permission
                                                      .ACCESS_FINE_LOCATION,
                                              Manifest.permission
                                                      .ACCESS_COARSE_LOCATION
                                          },
                                          LOCATION_REQUEST);
                      }

                      return;
                  }

                  try {

                      org.maplibre.android.location
                              .LocationComponentActivationOptions
                              activation =
                              org.maplibre.android.location
                                      .LocationComponentActivationOptions
                                      .builder(
                                              context,
                                              map.getStyle())
                                      .build();

                      map.getLocationComponent()
                              .activateLocationComponent(
                                      activation);

                      map.getLocationComponent()
                              .setLocationComponentEnabled(
                                      true);

                  } catch (Exception ignored) {
                  }
              }

              public void zoomIn() {

                  if (map == null) return;

                  double zoom =
                          map.getCameraPosition()
                                  .zoom;

                  map.animateCamera(
                          CameraUpdateFactory.zoomTo(
                                  Math.min(
                                          20.0,
                                          zoom + 1.0)),
                          250);
              }

              public void zoomOut() {

                  if (map == null) return;

                  double zoom =
                          map.getCameraPosition()
                                  .zoom;

                  map.animateCamera(
                          CameraUpdateFactory.zoomTo(
                                  Math.max(
                                          1.0,
                                          zoom - 1.0)),
                          250);
              }

              public void recenter() {

                  if (map == null) return;

                  if (cameraController == null) return;

                  cameraController.recenter();
              }

              public void renderRoute(
                      NavigationRouteController.RouteResult route) {

                  if (routeRenderer == null
                          || route == null) {
                      return;
                  }

                  routeRenderer.render(
                          route.points);
              }

              public void clearRoute() {

                  if (routeRenderer != null) {
                      routeRenderer.clear();
                  }
              }

              public NavigationCameraController
              getCameraController() {
                  return cameraController;
              }

              public MapLibreMap getMap() {
                  return map;
              }

              public void onHostResume() {
                  mapView.onResume();

                  if (cameraController != null) {
                      cameraController.start();
                  }
              }

              public void onHostPause() {

                  if (cameraController != null) {
                      cameraController.stop();
                  }

                  mapView.onPause();
              }

              public void onHostDestroy() {

                  if (cameraController != null) {
                      cameraController.stop();
                  }

                  mapView.onDestroy();
              }
          }
          EOF

          test -f "$FILE"
          grep -Fq 'class NavigationMapView' "$FILE"
          grep -Fq 'NavigationCameraController' "$FILE"
          grep -Fq 'NavigationRouteRenderer' "$FILE"
          grep -Fq 'renderRoute' "$FILE"
          grep -Fq 'recenter()' "$FILE"

          echo "NAVIGATION MAP V2: PASS"

