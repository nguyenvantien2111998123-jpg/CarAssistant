<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Car Assistant V9 — split screen cho Android Auto.
      KHÔNG có <uses-permission> nào: mọi thao tác đặc quyền đi qua `su`.
    -->

    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_aacast"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_aacast"
        android:supportsRtl="true"
        android:theme="@style/Theme.AACast"
        android:usesCleartextTraffic="false">

        <!-- UI trên màn hình điện thoại -->
        <activity
            android:name="com.carassistant.v9.MainActivity"
            android:configChanges="density|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.AACast.Phone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- UI trên màn hình xe (do Android Auto host khởi chạy) -->
        <activity
            android:name="com.carassistant.v9.AACastCarActivity"
            android:configChanges="density|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:resizeableActivity="true" />

        <!-- Đăng ký làm Car App với Android Auto -->
        <service
            android:name="com.carassistant.v9.AACastCarService"
            android:exported="true"
            android:icon="@drawable/ic_aacast"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <!-- Kênh IPC lease dock giữa app và gearhead -->
        <provider
            android:name="com.carassistant.v9.DockStateProvider"
            android:authorities="com.carassistant.v9.launcher.dock"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/Theme.AACast" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_aacast" />

        <!-- Xposed / LSPosed -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
